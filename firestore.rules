rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isMain() {
      return verified() && request.auth.token.email.lower() == 'resha9966@gmail.com';
    }
    function isAdmin() {
      return isMain() || (
        verified() &&
        exists(/databases/$(database)/documents/settings/admins) &&
        request.auth.token.email.lower() in get(/databases/$(database)/documents/settings/admins).data.emails
      );
    }

    /* طلبات العملاء: الإنشاء متاح للزوار بقيود صارمة، والقراءة والتعديل للأدمن فقط */
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','phone2','service','notes','status','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 25
        && request.resource.data.service is string && request.resource.data.service.size() <= 80
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 800
        && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    /* التقييمات: القراءة العامة للمنشور فقط، والإضافة للمسجلين كمراجعة معلقة */
    match /reviews/{id} {
      allow read: if resource.data.visible == true || isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if (signedIn()
        && request.resource.data.visible == false
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.text is string && request.resource.data.text.size() >= 5 && request.resource.data.text.size() <= 600)
        || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /invoices/{id} { allow read, write: if isAdmin(); }

    match /portfolio/{id} {  /* قديم: لم يعد مستخدماً */
      allow read: if true;
      allow write: if isAdmin();
    }

    /* صور الموقع (المؤسس وصور الخدمات): قراءة عامة، تعديل للأدمن فقط */
    match /media/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* إعدادات الموقع (مثل إخفاء التعليقات التجريبية) */
    match /settings/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* بنرات بداية الموقع: قراءة عامة، وكتابة للأدمن فقط */
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/payments {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/admins {
      allow read: if isAdmin();
      allow write: if isMain();
    }
  }
}
